{
  "name": "tacet-lab",
  "version": "3.8.2",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "data:sync:echoes": "node scripts/sync-catalog-data.mjs",
    "data:sync:wuwalab": "node scripts/fetch-wuwalab-combat-data.mjs && node scripts/sync-imported-combat-data.mjs",
    "data:sync:scanner-signatures": "node scripts/generate-scanner-signatures.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:optimizer": "vitest bench src/domain/optimizer.bench.ts --run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@pixi-spine/all-4.1": "^4.0.6",
    "dexie": "^4.0.11",
    "html-to-image": "^1.11.13",
    "pixi.js": "^7.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
